//SMPEAPY JOB (ACCT),'DUMMY SMP APPLY',CLASS=A,MSGCLASS=X
//APPLY   EXEC PGM=GIMSMP,REGION=0M
//SMPCSI  DD DSN=SMPE.GLOBAL.CSI,DISP=SHR
//SMPTLIB DD DSN=SMPE.TARGET.LINKLIB,DISP=SHR
//SMPCNTL DD *
  SET BOUNDARY(TK5TZN).
  APPLY S(DUMY001)
        CHECK
        LIST(ALL)
        SOURCEID(PRACTICE).
